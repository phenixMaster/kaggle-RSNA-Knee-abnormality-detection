# Byte-compiled / optimized / DLLs
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
#  Essentially everything PyInstaller creates is unnecessary to commit
*.manifest
*.spec

# pipenv
#   Pipenv creates a Pipfile.lock that contains the exact versions of the dependencies.
#   This is useful for ensuring that the same environment is used across different machines.
.venv/
venv/
ENV/
env/

# uv
.venv/
uv.lock # Remove this if you want to allow versions to float, but keep for reproducible builds

# Kaggle / Local environment
.kaggle/
.DS_Store
.DS_Store?
Thumbs.db
*.log
*.pth
*.ckpt
*.bin
*.h5
*.zip
*.tar.gz
*.tgz

# Data (Crucial: Never push raw DICOMs or large CSVs)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# IDEs
.vscode/
.idea/
.cursor/
.trae/
